    "sm2_algorithm": {
      "quality_range": "0-5",
      "quality_lt3_behavior": "reset ease=easeInit(2.5), interval=1",
      "quality_gte3_behavior": "SM-2 formula: newEase = clamp(ease + 0.1-(5-q)*(0.08+(5-q)*0.02), 1.3, 2.5); interval = round(interval * newEase)",
      "first_interval": "intervalDays=0 → nextInterval=1d",
      "ease_guard_rail": "[1.3, 2.5]",
      "interval_max_days": 60,
      "config_source": "@ConfigurationProperties('review.sm2')"
    },
    "mastered_threshold": {
      "condition": "consecutiveGoodCount >= 3 && easeFactor >= 2.8",
      "action": "UPDATE all 7 rows status=mastered + deleted_at=now() + send review.mastered event",
      "source": "Q-G decision"
    },
    "t0_timing": {
      "value": "now() + 2h (user timezone via X-User-Timezone header)",
