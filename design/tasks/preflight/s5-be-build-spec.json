  "_business_rules": {
    "state_machine": {
      "states": ["active", "mastered"],
      "transitions": [
        {"from": "active", "to": "mastered", "trigger": "连续3次 ease≥2.8 (Q-G)"},
        {"from": "mastered", "to": "active", "trigger": "禁止 (软删后不可逆)"}
      ],
      "invariants": [
        "INV-01: mastered 触发后所有 7 行同时 status=mastered + deleted_at=now()",
        "INV-02: dispatch_version 单调递增 (乐观锁)",
        "INV-03: (wrong_item_id, node_index) UNIQUE WHERE deleted_at IS NULL"
      ]
    },
    "idempotency": {
      "scope": "WrongItemAnalyzedConsumer.onMessage",
      "key_pattern": "DB UNIQUE INDEX (wrong_item_id, node_index) WHERE deleted_at IS NULL",
      "ttl_seconds": null,
      "fallback": "ON CONFLICT DO NOTHING"
    },
    "soft_delete": {
      "column": "deleted_at TIMESTAMPTZ",
      "trigger": "mastered (all 7 rows simultaneously)",
      "annotation": "@SQLDelete + @Where(clause='deleted_at IS NULL')",
      "post_delete_get": "404 (plan not found or mastered)"
    },
    "optimistic_lock": {
      "column": "dispatch_version BIGINT",
      "conflict_http_status": 409,
      "note": "SELECT FOR UPDATE pattern — see SC-08.AC-1"
