/* P03 analyzing · Mood A · STYLE-TRUTH §3 + §4.3 + §4.8 */

.page-analyzing {
  min-height: 100vh;
  background: var(--tkn-color-bg);
}

.hero {
  position: relative;
  min-height: 100vh;
  background: var(--tkn-grad-hero-card);
  overflow: hidden;
  padding: 160rpx 32rpx 80rpx;
  color: var(--tkn-color-card);
}

.hero-blob {
  position: absolute;
  border-radius: 50%;
  filter: blur(40rpx);
}

.blob-purple {
  width: 400rpx;
  height: 400rpx;
  top: -100rpx;
  right: -120rpx;
  background: radial-gradient(circle, var(--tkn-blob-purple), transparent 70%);
}

.blob-cyan {
  width: 360rpx;
  height: 360rpx;
  bottom: -120rpx;
  left: -100rpx;
  background: radial-gradient(circle, var(--tkn-blob-cyan), transparent 70%);
}

.hsafe {
  position: relative;
  z-index: 2;
  text-align: center;
}

.title {
  font-size: var(--tkn-fs-card-lg);
  font-weight: 800;
  letter-spacing: -0.4rpx;
}

.sub {
  margin-top: 16rpx;
  font-size: var(--tkn-fs-body);
  color: rgba(255, 255, 255, 0.78);
  min-height: 60rpx;
  line-height: 1.5;
  white-space: pre-wrap;
}

.ring {
  margin: 64rpx auto 48rpx;
  width: 280rpx;
  height: 280rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.06);
  border: 8rpx solid rgba(255, 255, 255, 0.18);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 0 0 4rpx rgba(0, 122, 255, 0.18), inset 0 0 36rpx rgba(0, 122, 255, 0.18);
}

.ring-num {
  font-size: 88rpx;
  font-weight: 800;
  letter-spacing: -2rpx;
  color: var(--tkn-color-card);
}

.ring-num .pct {
  font-size: 36rpx;
  font-weight: 600;
  margin-left: 6rpx;
  color: rgba(255, 255, 255, 0.72);
}

.stages {
  margin: 0 auto;
  max-width: 480rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.stage-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 18rpx 24rpx;
  border-radius: var(--tkn-radius-sm);
  background: rgba(255, 255, 255, 0.08);
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  font-size: var(--tkn-fs-body);
  color: rgba(255, 255, 255, 0.72);
  font-weight: 600;
}

.stage-row.on {
  background: rgba(0, 122, 255, 0.18);
  border-color: rgba(0, 122, 255, 0.4);
  color: var(--tkn-color-card);
}

.stage-row.done {
  color: rgba(255, 255, 255, 0.92);
}

.stage-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.3);
}

.stage-row.on .stage-dot {
  background: var(--tkn-color-card);
  box-shadow: 0 0 0 8rpx rgba(255, 255, 255, 0.18);
}

.fallback {
  margin: 28rpx auto 0;
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  padding: 12rpx 24rpx;
  border-radius: var(--tkn-radius-pill);
  background: rgba(255, 209, 102, 0.12);
  border: 1rpx solid rgba(255, 209, 102, 0.28);
  color: #FFD166;
  font-size: 24rpx;
  font-weight: 600;
}

.cancel {
  margin: 64rpx auto 0;
  display: inline-flex;
  padding: 18rpx 56rpx;
  border-radius: var(--tkn-radius-pill);
  background: rgba(255, 255, 255, 0.14);
  border: 1rpx solid rgba(255, 255, 255, 0.24);
  color: var(--tkn-color-card);
  font-size: var(--tkn-fs-body);
  font-weight: 700;
}
