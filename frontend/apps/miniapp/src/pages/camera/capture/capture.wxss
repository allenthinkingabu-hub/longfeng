/* P02 capture · Mood C dark-camera · STYLE-TRUTH §3 + §4.19-§4.22 */

.page-capture {
  min-height: 100vh;
  background: var(--tkn-camera-screen);
  color: var(--tkn-color-card);
  position: relative;
  display: flex;
  flex-direction: column;
}

.status-pad {
  height: 88rpx;
}

.cam-nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 28rpx;
  height: 88rpx;
  background: rgba(11, 15, 26, 0.5);
  backdrop-filter: blur(40rpx);
}

.cam-nav .nav-title {
  font-size: var(--tkn-fs-card-t);
  font-weight: 700;
  color: var(--tkn-color-card);
}

.nav-icon-btn {
  width: 72rpx;
  height: 72rpx;
  border-radius: var(--tkn-radius-2xs);
  background: rgba(255, 255, 255, 0.1);
  border: 1rpx solid rgba(255, 255, 255, 0.18);
  backdrop-filter: blur(40rpx);
  display: flex;
  align-items: center;
  justify-content: center;
}

/* Viewfinder · §4 + §2.6 grad-camera-vf */
.viewfinder {
  position: relative;
  flex: 1;
  margin: 28rpx 32rpx;
  border-radius: 36rpx;
  background: var(--tkn-grad-camera-vf);
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 800rpx;
}

/* 模拟纸面 · §3 Mood C 关键 */
.paper {
  position: relative;
  width: 84%;
  padding: 56rpx 48rpx;
  background: var(--tkn-grad-paper);
  border-radius: 8rpx;
  box-shadow: 0 60rpx 140rpx rgba(0, 0, 0, 0.55), 0 8rpx 24rpx rgba(0, 0, 0, 0.4);
  transform: rotate(-1.5deg);
}

.paper-line {
  font-family: "Times New Roman", Times, serif;
  font-size: 28rpx;
  color: #2C2A26;
  margin-bottom: 16rpx;
  line-height: 1.6;
}

.paper-mark {
  font-family: "Times New Roman", Times, serif;
  font-size: 30rpx;
  color: #C41E3A;
  font-style: italic;
  text-decoration: underline wavy #C41E3A;
}

/* 4 角黄 brackets · §4.20 */
.bracket {
  position: absolute;
  width: 92rpx;
  height: 92rpx;
  border: 6rpx solid var(--tkn-color-yellow);
  box-shadow: 0 0 36rpx rgba(255, 204, 0, 0.45);
  z-index: 5;
}

.br-tl {
  top: 60rpx;
  left: 60rpx;
  border-right: none;
  border-bottom: none;
  border-top-left-radius: 16rpx;
}

.br-tr {
  top: 60rpx;
  right: 60rpx;
  border-left: none;
  border-bottom: none;
  border-top-right-radius: 16rpx;
}

.br-bl {
  bottom: 60rpx;
  left: 60rpx;
  border-right: none;
  border-top: none;
  border-bottom-left-radius: 16rpx;
}

.br-br {
  bottom: 60rpx;
  right: 60rpx;
  border-left: none;
  border-top: none;
  border-bottom-right-radius: 16rpx;
}

/* 黄扫描线 · §4.20 */
.scan-line {
  position: absolute;
  top: 48%;
  left: 8%;
  right: 8%;
  height: 4rpx;
  background: linear-gradient(90deg, transparent, rgba(255, 204, 0, 0.95), transparent);
  box-shadow: 0 0 36rpx rgba(255, 204, 0, 0.7);
  z-index: 6;
}

/* Detect badge · §4.20 */
.detect-badge {
  position: absolute;
  top: 36rpx;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 12rpx 24rpx;
  border-radius: var(--tkn-radius-pill);
  background: rgba(0, 0, 0, 0.55);
  backdrop-filter: blur(36rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  z-index: 7;
}

.detect-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: var(--tkn-color-yellow);
  box-shadow: 0 0 0 12rpx rgba(255, 204, 0, 0.18);
}

.detect-badge text {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--tkn-color-card);
}

/* Tip 卡 · §4.22 */
.tip {
  margin: 0 32rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 22rpx 28rpx;
  border-radius: var(--tkn-radius-sm);
  background: rgba(255, 255, 255, 0.12);
  backdrop-filter: blur(40rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.15);
}

.tip text {
  font-size: var(--tkn-fs-body);
  color: rgba(255, 255, 255, 0.92);
  letter-spacing: 0.2rpx;
}

/* 学科 chips · §4.21 */
.subj-row {
  display: flex;
  gap: 12rpx;
  padding: 24rpx 32rpx 16rpx;
}

.subj {
  flex: 1;
  height: 72rpx;
  border-radius: var(--tkn-radius-2xs);
  background: rgba(255, 255, 255, 0.1);
  backdrop-filter: blur(36rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.18);
  font-size: var(--tkn-fs-body);
  font-weight: 600;
  color: var(--tkn-color-card);
  display: flex;
  align-items: center;
  justify-content: center;
}

.subj.on {
  background: rgba(255, 255, 255, 0.95);
  color: var(--tkn-color-blue);
  border-color: transparent;
  box-shadow: 0 12rpx 36rpx rgba(0, 0, 0, 0.18);
}

/* Bottom dock · §4.27 dark mode */
.cam-dock {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 36rpx 64rpx 64rpx;
  background: var(--tkn-grad-camera-dock);
}

.dock-side {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  color: rgba(255, 255, 255, 0.85);
}

.dock-side text {
  font-size: var(--tkn-fs-tabbar);
  font-weight: 500;
}

/* Shutter · §4.19 · 三层环 + 蓝核 */
.shutter {
  width: 156rpx;
  height: 156rpx;
  border-radius: 50%;
  background: var(--tkn-color-card);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow:
    0 0 0 8rpx rgba(255, 255, 255, 0.18),
    0 0 0 16rpx rgba(255, 255, 255, 0.10),
    0 28rpx 56rpx rgba(0, 0, 0, 0.35);
}

.shutter-core {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: var(--tkn-grad-icon-blue-deep);
  border: 6rpx solid var(--tkn-color-card);
}
