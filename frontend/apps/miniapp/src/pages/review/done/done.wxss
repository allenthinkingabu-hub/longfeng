/* P09 review done · Mood D celebrate-green · STYLE-TRUTH §3 */

.page-done {
  min-height: 100vh;
  background: var(--tkn-grad-cta-celebrate);
  color: var(--tkn-color-card);
  display: flex;
  flex-direction: column;
}

.hero {
  position: relative;
  flex: 1;
  padding: 120rpx 32rpx 48rpx;
  overflow: hidden;
}

.hero-blob {
  position: absolute;
  border-radius: 50%;
  filter: blur(40rpx);
  opacity: 0.55;
}

.blob-aurora-1 {
  width: 480rpx;
  height: 480rpx;
  top: -150rpx;
  right: -180rpx;
  background: radial-gradient(circle, rgba(109, 255, 161, 0.7), transparent 70%);
}

.blob-aurora-2 {
  width: 400rpx;
  height: 400rpx;
  bottom: 60rpx;
  left: -160rpx;
  background: radial-gradient(circle, rgba(255, 209, 102, 0.5), transparent 70%);
}

/* Confetti · 仅 allDone 渲染 */
.confetti {
  position: absolute;
  inset: 0;
  pointer-events: none;
  z-index: 4;
}

.confetti-bit {
  position: absolute;
  width: 16rpx;
  height: 28rpx;
  border-radius: 4rpx;
  animation: confetti-fall 1.4s ease-out infinite;
}

.b1 { left: 12%; top: 6%; background: #FFD166; animation-delay: 0s; }
.b2 { left: 28%; top: 12%; background: #FF6B6B; animation-delay: .2s; }
.b3 { left: 50%; top: 4%; background: #6DE895; animation-delay: .4s; }
.b4 { left: 70%; top: 14%; background: #C581F7; animation-delay: .1s; }
.b5 { left: 84%; top: 8%; background: #5AA3FF; animation-delay: .3s; }
.b6 { left: 40%; top: 20%; background: #FFB454; animation-delay: .5s; }

@keyframes confetti-fall {
  0% { transform: translateY(-40rpx) rotate(0deg); opacity: 1; }
  100% { transform: translateY(160rpx) rotate(360deg); opacity: 0; }
}

@media (prefers-reduced-motion: reduce) {
  .confetti-bit { animation: none; }
}

.hsafe {
  position: relative;
  z-index: 6;
  text-align: center;
}

.trophy {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  margin: 0 auto 36rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.18);
  display: flex;
  align-items: center;
  justify-content: center;
}

.trophy-emoji {
  font-size: 100rpx;
  line-height: 1;
  z-index: 2;
}

.trophy-pulse {
  position: absolute;
  inset: 0;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.18);
  animation: trophy-pulse 1.6s ease-out infinite;
}

@keyframes trophy-pulse {
  0% { transform: scale(0.85); opacity: 0.7; }
  100% { transform: scale(1.4); opacity: 0; }
}

@media (prefers-reduced-motion: reduce) {
  .trophy-pulse { animation: none; opacity: 0; }
}

.title {
  font-size: var(--tkn-fs-hero-md);
  font-weight: 800;
  letter-spacing: -0.6rpx;
  color: var(--tkn-color-card);
}

.sub {
  margin-top: 16rpx;
  font-size: var(--tkn-fs-body);
  color: rgba(255, 255, 255, 0.85);
}

.metrics {
  margin-top: 56rpx;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
}

.metric {
  padding: 24rpx 16rpx;
  border-radius: var(--tkn-radius-sm);
  background: rgba(255, 255, 255, 0.16);
  backdrop-filter: blur(20rpx);
  border: 2rpx solid rgba(255, 255, 255, 0.22);
  text-align: center;
}

.m-n {
  display: block;
  font-size: 44rpx;
  font-weight: 800;
  letter-spacing: -0.6rpx;
}

.m-l {
  display: block;
  margin-top: 6rpx;
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.78);
  font-weight: 600;
  letter-spacing: 0.4rpx;
}

.all-done-hint {
  margin-top: 28rpx;
  font-size: var(--tkn-fs-card-t);
  font-weight: 800;
  color: #FFD166;
  letter-spacing: 0.6rpx;
}

.cta-dock {
  display: flex;
  gap: 20rpx;
  padding: 28rpx 32rpx 60rpx;
}

.btn-ghost-light,
.btn-celebrate {
  flex: 1;
  height: 92rpx;
  border-radius: var(--tkn-radius-sm);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--tkn-fs-card-t);
  font-weight: 800;
}

.btn-ghost-light {
  background: rgba(255, 255, 255, 0.18);
  color: var(--tkn-color-card);
  border: 2rpx solid rgba(255, 255, 255, 0.32);
}

.btn-celebrate {
  background: var(--tkn-color-card);
  color: #0F7F3E;
  box-shadow: 0 12rpx 32rpx rgba(0, 0, 0, 0.18);
}
