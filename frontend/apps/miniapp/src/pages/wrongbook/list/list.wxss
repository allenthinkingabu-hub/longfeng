/* P05 wrongbook list · Mood B · STYLE-TRUTH §3 + §4 */

.page-list {
  min-height: 100vh;
  background: var(--tkn-color-bg);
  padding-bottom: 40rpx;
}

/* Tabs · pill 样式 */
.filter-bar {
  display: flex;
  gap: 12rpx;
  padding: 24rpx 28rpx 16rpx;
  background: var(--tkn-color-bg);
}

.tab {
  flex: 1;
  height: 76rpx;
  border-radius: var(--tkn-radius-2xs);
  background: rgba(118, 118, 128, 0.08);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--tkn-fs-body);
  font-weight: 600;
  color: var(--tkn-color-sec);
}

.tab.on {
  background: var(--tkn-color-card);
  color: var(--tkn-color-blue);
  font-weight: 800;
  box-shadow: var(--tkn-shadow-card);
}

/* 学科 chip 横滑 */
.subject-row {
  white-space: nowrap;
  padding: 8rpx 28rpx 16rpx;
}

.schip {
  display: inline-flex;
  align-items: center;
  height: 56rpx;
  padding: 0 24rpx;
  margin-right: 12rpx;
  border-radius: var(--tkn-radius-pill);
  background: var(--tkn-color-card);
  border: 1rpx solid var(--tkn-color-sep);
  font-size: var(--tkn-fs-body-sm);
  font-weight: 600;
  color: var(--tkn-color-sec);
}

.schip.on {
  background: var(--tkn-color-blue);
  color: var(--tkn-color-card);
  border-color: var(--tkn-color-blue);
}

.skeleton-wrap {
  padding: 28rpx;
}

.empty {
  padding: 96rpx 28rpx;
  text-align: center;
}

.empty .btn-primary {
  margin: 24rpx auto 0;
  width: 320rpx;
}

.list {
  padding: 0 28rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.item-card {
  display: flex;
  gap: 20rpx;
  padding: 20rpx;
  background: var(--tkn-color-card);
  border-radius: var(--tkn-radius-card);
  box-shadow: var(--tkn-shadow-card);
}

.item-thumb {
  width: 144rpx;
  height: 144rpx;
  border-radius: var(--tkn-radius-xs);
  background: var(--tkn-color-bg);
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
}

.item-thumb image {
  width: 100%;
  height: 100%;
}

.thumb-fallback {
  font-size: 22rpx;
  font-weight: 700;
  color: var(--tkn-color-ter);
}

.item-body {
  flex: 1;
  min-width: 0;
}

.item-row1 {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.subj-tag {
  display: inline-flex;
  padding: 4rpx 14rpx;
  border-radius: var(--tkn-radius-4xs);
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 0.4rpx;
}

.tag-math {
  background: rgba(196, 30, 58, 0.12);
  color: var(--tkn-subject-math);
}

.tag-physics {
  background: rgba(0, 87, 183, 0.12);
  color: var(--tkn-subject-physics);
}

.tag-chemistry {
  background: rgba(26, 107, 58, 0.12);
  color: var(--tkn-subject-chemistry);
}

.tag-english {
  background: rgba(156, 79, 0, 0.12);
  color: var(--tkn-subject-english);
}

.item-status {
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 0.4rpx;
}

.status-completed {
  color: var(--tkn-color-green);
}

.status-analyzing,
.status-pending {
  color: var(--tkn-color-orange);
}

.status-error {
  color: var(--tkn-color-red);
}

.item-stem {
  font-size: var(--tkn-fs-body);
  line-height: 1.45;
  color: var(--tkn-color-text);
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.item-row3 {
  margin-top: 12rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.mastery-bar {
  flex: 1;
  height: 12rpx;
  border-radius: 6rpx;
  background: rgba(118, 118, 128, 0.12);
  overflow: hidden;
}

.mastery-fill {
  height: 100%;
  background: var(--tkn-grad-icon-blue-deep);
  border-radius: 6rpx;
}

.mastery-num {
  font-size: 20rpx;
  font-weight: 700;
  color: var(--tkn-color-sec);
}

.tag-row {
  margin-top: 10rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.tag-chip {
  padding: 4rpx 12rpx;
  border-radius: var(--tkn-radius-4xs);
  background: var(--tkn-color-bg);
  font-size: 20rpx;
  color: var(--tkn-color-sec);
}

.load-more,
.load-end {
  text-align: center;
  padding: 28rpx;
  font-size: var(--tkn-fs-body-sm);
  color: var(--tkn-color-sec);
  font-weight: 600;
}

.load-end {
  color: var(--tkn-color-ter);
}
