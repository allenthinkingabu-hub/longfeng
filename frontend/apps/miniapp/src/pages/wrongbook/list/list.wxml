
<view class="page-list" data-mood="B" data-test-id="{{tids.wrongbookList.root}}">

  <view class="filter-bar" data-test-id="{{tids.wrongbookList['filter-bar']}}">
    <view class="tab {{tab==='active'?'on':''}}" bindtap="onTab" data-tab="active" data-test-id="{{tids.wrongbookList['active-tab']}}">{{i.tab_active}}</view>
    <view class="tab {{tab==='archive'?'on':''}}" bindtap="onTab" data-tab="archive" data-test-id="{{tids.wrongbookList['archive-tab']}}">{{i.tab_archive}}</view>
  </view>

  <scroll-view class="subject-row" scroll-x="true">
    <view class="schip {{!subjectFilter?'on':''}}" bindtap="onSubject" data-subject="">全部</view>
    <view class="schip {{subjectFilter==='math'?'on':''}}" bindtap="onSubject" data-subject="math">数学</view>
    <view class="schip {{subjectFilter==='physics'?'on':''}}" bindtap="onSubject" data-subject="physics">物理</view>
    <view class="schip {{subjectFilter==='chemistry'?'on':''}}" bindtap="onSubject" data-subject="chemistry">化学</view>
    <view class="schip {{subjectFilter==='english'?'on':''}}" bindtap="onSubject" data-subject="english">英语</view>
  </scroll-view>

  <view wx:if="{{loading && !items.length}}" class="skeleton-wrap">
    <van-skeleton row="6" row-width="100%" />
  </view>

  <view wx:elif="{{!items.length}}" class="empty" data-test-id="{{tids.wrongbookList.empty}}">
    <van-empty description="{{i.empty_active}}" />
    <view class="btn-primary" bindtap="onGoCapture">去拍一张</view>
  </view>

  <view wx:else class="list">
    <block wx:for="{{items}}" wx:key="id">
      <view class="item-card" bindtap="onItemTap" data-id="{{item.id}}" data-test-id="{{tids.wrongbookList['item-card']}}">
        <view class="item-thumb">
          <image wx:if="{{item.image_url}}" src="{{item.image_url}}" mode="aspectFill"></image>
          <view wx:else class="thumb-fallback">{{item.subject_label}}</view>
        </view>
        <view class="item-body">
          <view class="item-row1">
            <view class="subj-tag tag-{{item.subject}}">{{item.subject_label}}</view>
            <view class="item-status status-{{item.status}}">{{statusLabel[item.status]}}</view>
          </view>
          <view class="item-stem">{{item.stem_text}}</view>
          <view class="item-row3">
            <view class="mastery-bar">
              <view class="mastery-fill" style="width:{{item.mastery}}%"></view>
            </view>
            <text class="mastery-num">{{item.mastery}}%</text>
          </view>
          <view wx:if="{{item.tags && item.tags.length}}" class="tag-row">
            <view class="tag-chip" wx:for="{{item.tags}}" wx:for-item="tg" wx:key="*this">{{tg}}</view>
          </view>
        </view>
      </view>
    </block>

    <view wx:if="{{hasMore}}" class="load-more" bindtap="onLoadMore" data-test-id="{{tids.wrongbookList['load-more']}}">{{loadingMore?i.loading:i.load_more}}</view>
    <view wx:else class="load-end">— 没有更多了 —</view>
  </view>

</view>
