
<view wx:if="{{item}}" class="page-detail" data-mood="B" data-test-id="{{tids.wrongbookDetail.root}}">

  <scroll-view class="scroll" scroll-y="true">

    <!-- 题干卡 -->
    <view class="card stem-card">
      <view class="meta-row">
        <view class="subj-tag tag-{{item.subject}}">{{subjectLabel}}</view>
        <view class="mastery-row">
          <text class="mastery-l">{{i.mastery}}</text>
          <text class="mastery-n">{{item.mastery}}%</text>
        </view>
      </view>
      <view class="stem-tx" data-test-id="{{tids.wrongbookDetail['stem-text']}}">{{item.stem_text}}</view>
      <image wx:if="{{item.image_url}}" src="{{item.image_url}}" mode="widthFix" class="stem-img"></image>

      <view class="tag-row" bindtap="openTagSheet" data-test-id="{{tids.wrongbookDetail['tag-sheet']}}">
        <view class="tag-chip" wx:for="{{item.tags}}" wx:key="*this">{{item}}</view>
        <view class="tag-edit-btn">
          <van-icon name="edit" color="#007AFF" size="14px" />
          <text>{{i.tag_edit}}</text>
        </view>
      </view>
    </view>

    <!-- AI 讲解 -->
    <view class="card explain-card">
      <view class="card-head">
        <view class="card-h-ic"><van-icon name="bulb-o" color="#fff" size="14px" /></view>
        <text class="card-t">{{i.explain_title}}</text>
      </view>
      <view class="explain" data-test-id="{{tids.wrongbookDetail['explain-stream']}}">{{explain || i.explain_loading}}</view>
    </view>

    <!-- 相似题 -->
    <view wx:if="{{similar.length}}" class="card similar-section">
      <view class="card-head">
        <text class="card-t">{{i.similar_title}}</text>
      </view>
      <view wx:for="{{similar}}" wx:key="id" class="similar-row" data-test-id="{{tids.wrongbookDetail['similar-card']}}">
        <view class="sim-meta">
          <view class="subj-tag tag-{{item.subject}}">{{item.subject}}</view>
          <text class="sim-d">d={{item.distance}}</text>
        </view>
        <view class="sim-stem">{{item.stem_text}}</view>
      </view>
    </view>

    <view style="height:160rpx"></view>
  </scroll-view>

  <!-- 底部 CTA -->
  <view class="cta-dock">
    <view class="btn-ghost" bindtap="onArchive" data-test-id="{{tids.wrongbookDetail.archive}}">{{i.archive}}</view>
    <view class="btn-primary" bindtap="onReviewNow">立即复习</view>
  </view>

  <!-- Tag 编辑 popup -->
  <van-popup show="{{sheetOpen}}" position="bottom" round bind:close="closeTagSheet" custom-style="padding: 32rpx;">
    <view class="sheet-title">编辑标签</view>
    <view class="chips-area">
      <view wx:for="{{subjectPool}}" wx:key="*this"
            class="chip {{localTags.indexOf(item)>=0?'on':''}}"
            data-tag="{{item}}"
            bindtap="toggleTag"
            data-test-id="{{tids.wrongbookDetail['tag-chip']}}">{{item}}</view>
    </view>
    <van-field placeholder="自定义标签" value="{{customTag}}" bind:change="onCustomInput" />
    <view class="sheet-actions">
      <view class="btn-ghost" bindtap="addCustom">+ 添加</view>
      <view class="btn-primary" bindtap="saveTags" data-test-id="{{tids.wrongbookDetail['tag-save']}}">{{savingTags?'保存中':i.tag_save}}</view>
    </view>
  </van-popup>
</view>
