/* P11 event detail · Mood B · STYLE-TRUTH §3 + §4 */

.page-event {
  min-height: 100vh;
  background: var(--tkn-color-bg);
  padding: 28rpx 28rpx 60rpx;
  display: flex;
  flex-direction: column;
}

.hero-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 28rpx 32rpx;
  border-radius: var(--tkn-radius-card);
  color: var(--tkn-color-card);
  margin-bottom: 20rpx;
  box-shadow: var(--tkn-shadow-card-deep);
}

.hero-study {
  background: var(--tkn-grad-hero-card);
}

.hero-exam {
  background: linear-gradient(135deg, #FF9500 0%, #FF3B30 100%);
}

.hero-general {
  background: linear-gradient(135deg, #C581F7 0%, #5856D6 100%);
}

.hero-ic {
  width: 88rpx;
  height: 88rpx;
  border-radius: var(--tkn-radius-md);
  background: rgba(255, 255, 255, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
}

.hero-tx {
  flex: 1;
  min-width: 0;
}

.hero-kicker {
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 1.6rpx;
  text-transform: uppercase;
  color: rgba(255, 255, 255, 0.78);
}

.hero-t {
  margin-top: 6rpx;
  font-size: 36rpx;
  font-weight: 800;
  letter-spacing: -0.4rpx;
}

.card {
  background: var(--tkn-color-card);
  border-radius: var(--tkn-radius-card);
  padding: 24rpx 28rpx;
  margin-bottom: 20rpx;
  box-shadow: var(--tkn-shadow-card);
}

.card-t {
  font-size: var(--tkn-fs-card-t);
  font-weight: 800;
  color: var(--tkn-color-text);
  margin-bottom: 16rpx;
}

.meta-row {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 0;
  border-top: 1rpx solid var(--tkn-color-sep);
}

.meta-row:first-child {
  border-top: none;
}

.meta-l {
  font-size: var(--tkn-fs-body-sm);
  color: var(--tkn-color-sec);
  font-weight: 600;
}

.meta-v {
  font-size: var(--tkn-fs-body);
  color: var(--tkn-color-text);
  font-weight: 700;
  text-align: right;
  max-width: 60%;
}

.item-row {
  padding: 16rpx 0;
  border-top: 1rpx solid var(--tkn-color-sep);
}

.item-row:first-of-type {
  border-top: none;
}

.item-stem {
  font-size: var(--tkn-fs-body-sm);
  color: var(--tkn-color-text);
  line-height: 1.45;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.item-meta {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--tkn-color-ter);
}

.cta-dock {
  margin-top: auto;
  display: flex;
  gap: 20rpx;
  padding: 24rpx 0 0;
}

.cta-dock .btn-ghost {
  flex: 1;
}

.cta-dock .btn-primary {
  flex: 1;
}
