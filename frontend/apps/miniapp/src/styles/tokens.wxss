/* S7-S8 miniapp · tokens.wxss · 对齐 STYLE-TRUTH.md §2 (iOS HIG + Mood A-E)
 * 唯一真相：design/system/STYLE-TRUTH.md
 * 严禁硬编码 hex / px · 所有页面通过 var(--tkn-*) 取值
 * Vant Weapp 主题在 vant-theme.wxss 二次绑定
 */
page {
  /* §2.1 表面 / 文字 */
  --tkn-color-bg: #F2F2F7;
  --tkn-color-card: #FFFFFF;
  --tkn-color-sep: rgba(60, 60, 67, 0.14);
  --tkn-color-text: #1C1C1E;
  --tkn-color-text2: #3C3C43;
  --tkn-color-sec: #636366;
  --tkn-color-ter: #8E8E93;

  /* §2.1 系统主色 (iOS HIG) */
  --tkn-color-blue: #007AFF;
  --tkn-color-red: #FF3B30;
  --tkn-color-orange: #FF9500;
  --tkn-color-green: #34C759;
  --tkn-color-indigo: #5856D6;
  --tkn-color-yellow: #FFCC00;
  --tkn-color-purple: #AF52DE;
  --tkn-color-teal: #30B0C7;
  --tkn-color-pink: #FF2D55;

  /* §2.1 Hero 渐变 stops */
  --tkn-hero-stop-1: #0F1A3D;
  --tkn-hero-stop-2: #1E3A8A;
  --tkn-hero-stop-3: #1F3C8C;
  --tkn-hero-stop-4: #3B5BDB;
  --tkn-hero-stop-5: #5B8DEF;
  --tkn-hero-stop-6: #5F5BDB;
  --tkn-hero-stop-7: #8B87F6;

  /* §2.1 Blob 装饰色 */
  --tkn-blob-purple: rgba(88, 86, 214, 0.55);
  --tkn-blob-cyan: rgba(88, 214, 255, 0.55);
  --tkn-blob-pink: rgba(255, 45, 85, 0.35);
  --tkn-blob-coral: rgba(255, 107, 107, 0.45);
  --tkn-blob-mint: rgba(79, 209, 217, 0.35);
  --tkn-blob-gold: rgba(255, 209, 102, 0.40);

  /* §2.1 Em 强调字渐变 */
  --tkn-grad-em-coral: linear-gradient(90deg, #FFD166 0%, #FF6B6B 100%);
  --tkn-grad-em-amber: linear-gradient(90deg, #FFD166, #FFB454);

  /* §2.1 学科色 */
  --tkn-subject-math: #C41E3A;
  --tkn-subject-physics: #0057B7;
  --tkn-subject-chemistry: #1A6B3A;
  --tkn-subject-english: #9C4F00;

  /* §2.1 KP 暖米橙 */
  --tkn-kp-bg-from: #FFF4E6;
  --tkn-kp-bg-to: #FFE0C2;
  --tkn-kp-border: rgba(255, 149, 0, 0.25);
  --tkn-kp-text-title: #8B4513;
  --tkn-kp-text-body: #A0522D;
  --tkn-kp-text-em: #6B2C0F;

  /* §2.1 Camera 暗底 */
  --tkn-camera-screen: #0B0F1A;

  /* §2.1 Mastery 自评色 (P08 铁律 1 例外) */
  --tkn-mastery-forgot: #FF3B30;
  --tkn-mastery-partial: #FF9500;
  --tkn-mastery-mastered: #34C759;

  /* §2.1 微信品牌绿 (P00 wechat-brand 例外) */
  --tkn-brand-wechat: #07C160;

  /* §2.6 渐变 */
  --tkn-grad-hero-home: linear-gradient(180deg, #1E3A8A 0%, #3B5BDB 45%, #5B8DEF 100%);
  --tkn-grad-hero-landing: linear-gradient(170deg, #0F1A3D 0%, #1F3C8C 40%, #5F5BDB 80%, #8B87F6 100%);
  --tkn-grad-hero-card: linear-gradient(135deg, #0F1A3D 0%, #1F3C8C 60%, #5F5BDB 100%);
  --tkn-grad-icon-red: linear-gradient(135deg, #FF6B6B, #FF3B30);
  --tkn-grad-icon-green: linear-gradient(135deg, #6DE895, #34C759);
  --tkn-grad-icon-blue: linear-gradient(135deg, #5AA3FF, #007AFF);
  --tkn-grad-icon-purple: linear-gradient(135deg, #C581F7, #8B87F6);
  --tkn-grad-icon-orange: linear-gradient(135deg, #FF9500, #FF3B30);
  --tkn-grad-icon-blue-deep: linear-gradient(180deg, #5FA8FF, #007AFF);
  --tkn-grad-cta-primary: linear-gradient(180deg, #5FA8FF, #007AFF);
  --tkn-grad-cta-deep: linear-gradient(135deg, #1F3C8C 0%, #5F5BDB 100%);
  --tkn-grad-cta-orange: linear-gradient(180deg, #FF9500, #E08100);
  --tkn-grad-cta-celebrate: linear-gradient(175deg, #0F7F3E 0%, #1FAE5C 40%, #34C759 100%);
  --tkn-grad-kp: linear-gradient(135deg, #FFF4E6 0%, #FFE0C2 100%);
  --tkn-grad-ebbing: linear-gradient(160deg, #EEF4FF 0%, #F7ECFF 100%);
  --tkn-grad-ans-wrong: linear-gradient(160deg, #FFE8E6 0%, #FFFFFF 70%);
  --tkn-grad-ans-right: linear-gradient(160deg, #E4F7EA 0%, #FFFFFF 70%);
  --tkn-grad-camera-vf: radial-gradient(800rpx 400rpx at 50% 30%, #1d2433 0%, #0B0F1A 65%);
  --tkn-grad-camera-dock: linear-gradient(180deg, rgba(11, 15, 26, 0) 0%, rgba(11, 15, 26, 0.85) 35%, #0B0F1A 100%);
  --tkn-grad-cta-dock: linear-gradient(180deg, rgba(242, 242, 247, 0), rgba(242, 242, 247, 0.92) 30%, #F2F2F7 100%);
  --tkn-grad-paper: linear-gradient(180deg, #fbf8f0, #f1ece0);

  /* §2.5 阴影 (轻量) */
  --tkn-shadow-card-light: 0 1px 0 rgba(0, 0, 0, 0.03);
  --tkn-shadow-card: 0 1px 2px rgba(0, 0, 0, 0.04);
  --tkn-shadow-card-deep: 0 1px 2px rgba(0, 0, 0, 0.04), 0 8px 22px rgba(40, 50, 90, 0.06);
  --tkn-shadow-hero-card: 0 10px 30px rgba(31, 60, 140, 0.25);
  --tkn-shadow-cta-blue: 0 10px 24px rgba(0, 122, 255, 0.28);
  --tkn-shadow-cta-deep: 0 12px 30px -6px rgba(31, 60, 140, 0.4), inset 0 1px 0 rgba(255, 255, 255, 0.25);
  --tkn-shadow-cta-orange: 0 4px 10px rgba(255, 149, 0, 0.28);
  --tkn-shadow-step-num: 0 4px 10px rgba(0, 122, 255, 0.3);
  --tkn-shadow-glow-yellow: 0 0 8px #FFD166;

  /* §2.3 圆角 */
  --tkn-radius-pill: 999px;
  --tkn-radius-card-lg: 22px;
  --tkn-radius-card: 18px;
  --tkn-radius-md: 16px;
  --tkn-radius-sm: 14px;
  --tkn-radius-xs: 12px;
  --tkn-radius-2xs: 10px;
  --tkn-radius-3xs: 8px;
  --tkn-radius-4xs: 6px;

  /* §2.4 间距 (4pt grid) */
  --tkn-space-2: 4rpx;
  --tkn-space-4: 8rpx;
  --tkn-space-6: 12rpx;
  --tkn-space-8: 16rpx;
  --tkn-space-10: 20rpx;
  --tkn-space-12: 24rpx;
  --tkn-space-14: 28rpx;
  --tkn-space-16: 32rpx;
  --tkn-space-18: 36rpx;
  --tkn-space-20: 40rpx;
  --tkn-space-24: 48rpx;
  --tkn-space-32: 64rpx;

  /* §2.2 字号 (px → rpx 1:2 in iPhone6 baseline; 此处用 rpx) */
  --tkn-fs-hero-lg: 64rpx;
  --tkn-fs-hero-md: 56rpx;
  --tkn-fs-card-lg: 48rpx;
  --tkn-fs-section: 44rpx;
  --tkn-fs-stat: 44rpx;
  --tkn-fs-tab-tt: 40rpx;
  --tkn-fs-card-t: 30rpx;
  --tkn-fs-body-em: 27rpx;
  --tkn-fs-body: 26rpx;
  --tkn-fs-body-sm: 24rpx;
  --tkn-fs-cap: 22rpx;
  --tkn-fs-stat-l: 20rpx;
  --tkn-fs-tabbar: 20rpx;
  --tkn-fs-eyebrow: 20rpx;
  --tkn-fs-micro: 18rpx;
}
