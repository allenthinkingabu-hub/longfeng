/* S7-S8 miniapp · 全局样式 · @import tokens · @import vant-theme
 * 设计权威：design/system/STYLE-TRUTH.md (iOS HIG + Mood A-E)
 */
@import "./styles/tokens.wxss";
@import "./styles/vant-theme.wxss";

page {
  background: var(--tkn-color-bg);
  color: var(--tkn-color-text);
  font-size: var(--tkn-fs-body);
  font-family: -apple-system, "SF Pro Text", "PingFang SC", sans-serif;
  -webkit-font-smoothing: antialiased;
}

/* 全局原子类（与 H5 ui-kit 同名） */
.row {
  display: flex;
  align-items: center;
}

.row-gap-sm {
  display: flex;
  gap: var(--tkn-space-4);
  align-items: center;
}

.row-gap-md {
  display: flex;
  gap: var(--tkn-space-8);
  align-items: center;
}

.col {
  display: flex;
  flex-direction: column;
}

.col-gap-sm {
  display: flex;
  flex-direction: column;
  gap: var(--tkn-space-4);
}

.col-gap-md {
  display: flex;
  flex-direction: column;
  gap: var(--tkn-space-8);
}

.muted {
  color: var(--tkn-color-sec);
  font-size: var(--tkn-fs-cap);
}

.dim {
  color: var(--tkn-color-ter);
  font-size: var(--tkn-fs-cap);
}

.screen-pad {
  padding: var(--tkn-space-12);
}

/* Mood 主题 (data-mood A-E) · STYLE-TRUTH §3 */
.mood-A {
  background: var(--tkn-color-bg);
}

.mood-B {
  background: var(--tkn-color-bg);
}

.mood-C {
  background: var(--tkn-camera-screen);
  color: var(--tkn-color-card);
}

.mood-D {
  background: var(--tkn-grad-cta-celebrate);
  color: var(--tkn-color-card);
}

.mood-E {
  background: linear-gradient(170deg, var(--tkn-hero-stop-1) 0%, var(--tkn-color-teal) 100%);
  color: var(--tkn-color-card);
}

/* iOS-like nav bar · 标准白底玻璃态 */
.app-nav {
  position: sticky;
  top: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  padding: 0 var(--tkn-space-12);
  background: rgba(242, 242, 247, 0.78);
  backdrop-filter: blur(22px) saturate(180%);
  border-bottom: 1rpx solid var(--tkn-color-sep);
  z-index: 30;
}

.app-nav .nav-title {
  font-size: var(--tkn-fs-card-t);
  font-weight: 700;
  color: var(--tkn-color-text);
}

.app-nav .nav-action {
  font-size: var(--tkn-fs-body);
  color: var(--tkn-color-blue);
  font-weight: 600;
}

/* 卡片 · STYLE-TRUTH §4.1 */
.card {
  background: var(--tkn-color-card);
  border-radius: var(--tkn-radius-card);
  padding: var(--tkn-space-12) var(--tkn-space-14);
  box-shadow: var(--tkn-shadow-card);
}

/* 主按钮 · STYLE-TRUTH §4.28 */
.btn-primary {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 92rpx;
  border-radius: var(--tkn-radius-sm);
  background: var(--tkn-grad-cta-primary);
  color: var(--tkn-color-card);
  font-size: var(--tkn-fs-card-t);
  font-weight: 600;
  box-shadow: var(--tkn-shadow-cta-blue);
}

.btn-ghost {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 92rpx;
  border-radius: var(--tkn-radius-sm);
  background: rgba(118, 118, 128, 0.12);
  color: var(--tkn-color-text);
  font-size: var(--tkn-fs-card-t);
  font-weight: 600;
}
