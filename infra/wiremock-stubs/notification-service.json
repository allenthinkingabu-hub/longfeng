{
  "mappings": [
    {
      "_comment": "WX_MP 推送 · 正常送达 (200 success=true)",
      "request": {
        "method": "POST",
        "urlPattern": "/notifications/wx-mp/send",
        "bodyPatterns": [
          { "matchesJsonPath": "$.msgkey" }
        ]
      },
      "response": {
        "status": 200,
        "headers": { "Content-Type": "application/json" },
        "jsonBody": {
          "success": true,
          "requestId": "wx-msgid-{{randomValue type='UUID'}}",
          "errorCode": null,
          "errorMsg": null
        }
      },
      "priority": 5
    },
    {
      "_comment": "WX_MP 推送 · 额度耗尽 (200 success=false QUOTA_EXHAUSTED)",
      "request": {
        "method": "POST",
        "urlPattern": "/notifications/wx-mp/send",
        "bodyPatterns": [
          { "matchesJsonPath": "$[?(@.msgkey =~ /.*quota-test.*/)]" }
        ]
      },
      "response": {
        "status": 200,
        "headers": { "Content-Type": "application/json" },
        "jsonBody": {
          "success": false,
          "requestId": null,
          "errorCode": "subscribe-msg-quota-exhausted",
          "errorMsg": "用户订阅消息配额已耗尽"
        }
      },
      "priority": 3
    },
    {
      "_comment": "WX_MP 推送 · 服务限流 (429)",
      "request": {
        "method": "POST",
        "urlPattern": "/notifications/wx-mp/send",
        "bodyPatterns": [
          { "matchesJsonPath": "$[?(@.msgkey =~ /.*rate-limit.*/)]" }
        ]
      },
      "response": {
        "status": 429,
        "headers": { "Content-Type": "application/json" },
        "jsonBody": {
          "success": false,
          "requestId": null,
          "errorCode": "RATE_LIMITED",
          "errorMsg": "Too Many Requests"
        }
      },
      "priority": 3
    },
